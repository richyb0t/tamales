rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
      // Clave REST de OneSignal: solo admin/sup/enc la escriben y admin/sup/enc la leen (no el repartidor).
      match /config/onesignal {
        allow read: if adm() || sup() || enc();
        allow write: if adm() || sup();
      }
    function hasProf() { return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function prof() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function ok() { return hasProf() && prof().active != false; }
    function adm() { return ok() && prof().role == 'admin'; }
function sup() { return ok() && prof().role == 'sup'; }
function admOrSup() { return adm() || sup(); }
    function enc() { return ok() && prof().role == 'enc'; }
    function rep() { return ok() && prof().role == 'rep'; }
    // El vendedor solo opera en la sucursal que eligió: su perfil la nombra Y él es el dueño de claims/<sucursal>.
    // Así, si otro vendedor toma la sucursal en un día nuevo, el anterior pierde el acceso aunque su perfil aún la mencione.
    function vend(b) {
      return ok() && prof().role == 'vend' && prof().branch == b
        && get(/databases/$(database)/documents/claims/$(string(b))).data.uid == request.auth.uid
    && get(/databases/$(database)/documents/claims/$(string(b))).data.ts <= request.time.toMillis()
    && request.time.toMillis() < get(/databases/$(database)/documents/claims/$(string(b))).data.ts + 86400000
    && (!exists(/databases/$(database)/documents/config/main) || !(b in get(/databases/$(database)/documents/config/main).data.get('closed', [])));

    }
    // IDs seguros (se usan dentro de atributos onclick) y venta con campos válidos.
    // Se permite el punto porque los usuarios pueden tenerlo (ej. ana.lopez) y el corte usa día_usuario.
    function okId(id) { return id.matches('^[A-Za-z0-9_.-]{1,128}$'); }
    // Precio: una venta o apartado se cobra al precio vigente en Ajustes (champurrado: precio de Ajustes; si no hay, 20/30/50).
    // Una devolución conserva el precio de la venta original, que pudo cambiar después, así que solo se le exige ser positivo.
    function priceOk(d) {
      return d.type == 'devolucion'
        ? d.price > 0
        : (d.f >= 100
            ? (d.price > 0 && (d.price == get(/databases/$(database)/documents/config/main).data.prices.get('f' + string(d.f), [20, 30, 50][d.f - 100])
                || (d.price < get(/databases/$(database)/documents/config/main).data.prices.get('f' + string(d.f), [20, 30, 50][d.f - 100])
                    && d.get('descuento', 0) > 0
                    && ((d.get('pre', null) == null || exists(/databases/$(database)/documents/pre/$(d.get('pre', null)))) && (d.get('dv', null) == null || exists(/databases/$(database)/documents/deliveries/$(d.get('dv', null))))))))
            : (d.price > 0 && (d.price == get(/databases/$(database)/documents/config/main).data.prices['f' + string(d.f)]
                || (d.price < get(/databases/$(database)/documents/config/main).data.prices['f' + string(d.f)]
                    && d.get('descuento', 0) > 0
                    && ((d.get('pre', null) == null || exists(/databases/$(database)/documents/pre/$(d.get('pre', null)))) && (d.get('dv', null) == null || exists(/databases/$(database)/documents/deliveries/$(d.get('dv', null)))))))));
    }
    function validSale(d) {
      return d.qty is int && d.qty > 0 && d.qty < 500
        && d.price is number && d.price < 10000
        && d.f is int && d.f >= 0 && d.f <= 102
        && d.type in ['vendido', 'apartado', 'devolucion']
        && d.by == prof().user
        && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && priceOk(d);
    }
    // Después del corte de caja el vendedor ya no puede mover dinero ese día (solo el administrador, anulando el corte)
    function noCut(day, author) { return author != null && !exists(/databases/$(database)/documents/cuts/$(day + '_' + author)); }
    // Elegir sucursal: un documento claims/<número de sucursal> por sucursal, que solo toma un vendedor por día
    function claimOk(id) {
      return ok() && prof().role == 'vend'
        && id.matches('^[0-9]{1,2}$')
        && request.resource.data.keys().hasOnly(['branch', 'day', 'uid', 'user', 'name', 'ts'])
        && request.resource.data.branch is int && string(request.resource.data.branch) == id
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.user == prof().user
        && request.resource.data.day is string && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && !(request.resource.data.branch in get(/databases/$(database)/documents/config/main).data.get('closed', []));
    }
    // Un vendedor solo cancela o entrega un apartado de su sucursal. Entregar exige que en el mismo lote
    // se cree la venta p<id>_0 (la app la crea así), para que no se pueda marcar entregado sin cobrar.
    function vendPreOk(id) {
      return request.resource.data.branch == resource.data.branch
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt', 'doneBy'])
        && request.resource.data.doneBy == prof().user
        && (request.resource.data.status == 'cancelado'
            || (request.resource.data.status == 'entregado'
                && getAfter(/databases/$(database)/documents/sales/$('p' + id + '_0')).data.type == 'vendido'
                && getAfter(/databases/$(database)/documents/sales/$('p' + id + '_0')).data.pre == id));
    }

    // Marca de que ya existe el primer administrador (se lee sin sesión para mostrar la pantalla de registro inicial)
    match /config/init {
      allow get: if true;
      allow create: if request.auth != null
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    
     // Una vez creado, no se puede modificar ni borrar: evita reabrir el bootstrap de admin.
     allow update, delete: if false;
}
    match /config/{doc} {
      allow read: if ok();
      allow write: if adm() || sup();
    }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || adm() || sup());
      allow create: if adm() || (request.auth != null && request.auth.uid == uid
        && request.resource.data.role == 'admin'
        && !exists(/databases/$(database)/documents/config/init)
        && existsAfter(/databases/$(database)/documents/config/init));
      // Cada usuario puede cambiar su nombre y sus identificadores de push; el vendedor además anota la sucursal que tomó
      allow update: if adm()
        || (ok() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'onesignalId', 'fcmToken'])
            && request.resource.data.get('name', '') is string
            && request.resource.data.get('name', '').size() <= 80
            && request.resource.data.get('onesignalId', '') is string
            && request.resource.data.get('fcmToken', '') is string)
        || (ok() && request.auth.uid == uid && prof().role == 'vend'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['branch', 'brDay'])
            && request.resource.data.branch is int
            && getAfter(/databases/$(database)/documents/claims/$(string(request.resource.data.branch))).data.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/claims/$(string(request.resource.data.branch))).data.day == request.resource.data.brDay);
      allow delete: if adm();
    }
    // Quién tiene cada sucursal hoy. Un vendedor toma una sucursal libre (o una de un día anterior), solo la suelta él o el administrador.
    match /claims/{id} {
      allow read: if ok();
      allow create: if adm() || claimOk(id);
      allow update: if adm() || (claimOk(id)
        && (resource.data.uid == request.auth.uid || resource.data.day < request.resource.data.day));
      allow delete: if adm() || (ok() && resource.data.uid == request.auth.uid);
    }
    match /loads/{id} {
      allow read: if adm() || sup() || enc() || vend(resource.data.branch);
      allow write: if adm() || sup();
    }
    match /sales/{id} {
      allow read: if adm() || sup() || enc() || vend(resource.data.branch);
      allow create: if adm() || (okId(id) && vend(request.resource.data.branch) && validSale(request.resource.data)
        && (request.resource.data.type == 'apartado' || noCut(request.resource.data.day, request.resource.data.by)))
        // El repartidor cobra un reparto que él mismo llevó y cerró
        || (rep() && request.resource.data.type == 'vendido'
            && request.resource.data.get('dv', null) is string
            && validSale(request.resource.data)
            && noCut(request.resource.data.day, request.resource.data.by)
            && getAfter(/databases/$(database)/documents/deliveries/$(request.resource.data.dv)).data.drv == prof().user
            && getAfter(/databases/$(database)/documents/deliveries/$(request.resource.data.dv)).data.status == 'entregado');
      // El vendedor solo puede entregar un apartado (apartado -> vendido) a su nombre, antes del corte; no cambia precio, cantidad ni ventas ya cobradas
      allow update: if adm() || (vend(resource.data.branch)
        && resource.data.type == 'apartado' && request.resource.data.type == 'vendido'
        && request.resource.data.branch == resource.data.branch
        && request.resource.data.by == prof().user
        && noCut(resource.data.day, resource.data.by)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'by']));
      // Anular una venta o devolución exige crear en el mismo lote su registro en la bitácora (logs/del_<id>) y no haber hecho el corte
      allow delete: if adm() || (vend(resource.data.branch)
        && (resource.data.type == 'apartado'
            || (noCut(resource.data.day, resource.data.by) && existsAfter(/databases/$(database)/documents/logs/$('del_' + id)))));
    }
    // Resumen de disponibilidad por sucursal (para apartar en otra sucursal). Cada vendedor solo publica el de su sucursal.
    match /stock/{id} {
      allow read: if ok();
      allow write: if adm() || sup() || (vend(request.resource.data.branch) && id == string(request.resource.data.branch));
    }
    // Solicitudes de apartado entre sucursales
    match /reqs/{id} {
      // Pedidos (enc) puede mandar solicitudes sin sucursal de origen (from == null) y ver solo las suyas
      allow read: if adm() || sup() || vend(resource.data.from) || vend(resource.data.to)
        || (enc() && resource.data.by == prof().user);
      allow create: if adm() || sup() || (okId(id) && vend(request.resource.data.from) && request.resource.data.status == 'pendiente'
        && request.resource.data.by == prof().user)
        || (okId(id) && enc() && request.resource.data.from == null && request.resource.data.to is int
            && request.resource.data.status == 'pendiente' && request.resource.data.by == prof().user);
      // Entregar exige que las ventas del apartado (q<id>_<n>, creadas al aceptar) pasen a 'vendido' en el mismo lote
      allow update: if adm() || sup()
        || (vend(resource.data.to)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'exp', 'acceptedBy', 'reason', 'rejectedBy', 'deliveredBy', 'dts'])
            && (
              (resource.data.status == 'pendiente' && request.resource.data.status in ['aceptado', 'rechazado'])
           || (resource.data.status == 'aceptado' && request.resource.data.status == 'cancelado')
           || (resource.data.status == 'aceptado' && request.resource.data.status == 'entregado'
               && getAfter(/databases/$(database)/documents/sales/$('q' + id + '_0')).data.type == 'vendido')))
        || (vend(resource.data.from) && resource.data.status == 'pendiente' && request.resource.data.status == 'cancelado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (enc() && resource.data.by == prof().user && resource.data.status == 'pendiente' && request.resource.data.status == 'cancelado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if adm();
    }
    // Cortes de caja: el vendedor crea el suyo (uno por día, no puede cambiarlo); solo el administrador lo anula
    match /cuts/{id} {
      allow read: if adm() || sup() || (ok() && resource.data.by == prof().user);
      allow create: if adm() || (okId(id) && vend(request.resource.data.branch) && request.resource.data.by == prof().user
        && id == request.resource.data.day + '_' + prof().user);
      allow update, delete: if adm();
    }
    // Lista pública mínima para la pantalla de perfiles (solo nombre, usuario, rol y activo). La mantiene el administrador.
    match /profiles/{uid} {
      allow read: if true;
      allow write: if adm();
    }
    // Apartados por fecha (hoy y otros días). Vendedor: los de su sucursal. Pedidos: puede crear y cancelar los suyos.
    match /pre/{id} {
      allow read: if adm() || sup() || enc() || vend(resource.data.branch);
      allow create: if okId(id) && (adm() || sup()
        || (enc() && request.resource.data.by == prof().user && request.resource.data.status == 'pendiente')
        || (vend(request.resource.data.branch) && request.resource.data.by == prof().user && request.resource.data.status == 'pendiente'));
      // Solo se modifica un apartado que sigue pendiente: así dos dispositivos no pueden entregar el mismo apartado
      allow update: if resource.data.status == 'pendiente' && (adm() || sup()
        || (vend(resource.data.branch) && vendPreOk(id))
        // El rol de pedidos administra los pedidos grandes: editarlos, cancelarlos y ligarles o quitarles reparto
        || (enc() && resource.data.get('large', false) == true
            && request.resource.data.get('large', false) == true
            && request.resource.data.get('by', null) == resource.data.get('by', null)
            && (request.resource.data.status == 'cancelado'
                || (request.resource.data.status == 'pendiente'
                    && (request.resource.data.get('dvId', null) == null
                        || existsAfter(/databases/$(database)/documents/deliveries/$(request.resource.data.dvId))))))
        // El repartidor cierra el pedido grande cuando entrega o falla el reparto
        || (rep() && resource.data.get('large', false) == true
            && resource.data.get('dvId', null) is string
            && request.resource.data.status in ['entregado', 'fallido']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reason', 'doneAt'])
            && getAfter(/databases/$(database)/documents/deliveries/$(resource.data.dvId)).data.drv == prof().user));
      allow delete: if adm() || sup() || (enc() && resource.data.get('large', false) == true);
    }
    // Bitácora de anulaciones y cancelaciones (solo el administrador la lee; no se puede editar ni borrar)
    match /logs/{id} {
      allow read: if adm() || sup();
      allow create: if adm() || sup()
        || (okId(id) && ok() && request.resource.data.by == prof().user && (prof().role == 'enc' || vend(request.resource.data.branch)));
    }
    match /transfers/{id} {
      allow read: if adm() || sup() || enc() || vend(resource.data.from) || vend(resource.data.to);
      allow create: if adm() || sup() || (okId(id) && vend(request.resource.data.from));
      allow delete: if adm() || sup() || (vend(resource.data.from) && existsAfter(/databases/$(database)/documents/logs/$('del_tr_' + id)));
    }
    // Repartos a domicilio: los crea el administrador o Pedidos; el repartidor los toma y cierra
    match /deliveries/{id} {
      allow read: if adm() || sup() || enc() || rep() || vend(resource.data.branch);
      allow create: if adm() || sup() || (enc() && request.resource.data.by == prof().user
        && request.resource.data.status == 'pendiente');
      allow update: if adm() || sup()
        || (rep() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'drv', 'drvName', 'tsTake', 'tsDone', 'cobrado', 'reason'])
            && (
              (resource.data.status == 'pendiente' && request.resource.data.status == 'en_ruta'
                && request.resource.data.drv == prof().user)
           || (resource.data.status == 'en_ruta' && resource.data.drv == prof().user
                && (request.resource.data.status in ['entregado', 'fallido']
                    || (request.resource.data.status == 'pendiente' && request.resource.data.drv == null)))))
        || (enc() && resource.data.by == prof().user && resource.data.status == 'pendiente'
            && request.resource.data.status == 'cancelado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (vend(resource.data.branch) && resource.data.status in ['pendiente', 'en_ruta']
            && request.resource.data.out == true
            && request.resource.data.outBy == prof().user
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['out', 'outBy', 'outName', 'outAt']));
      allow delete: if (adm() || sup() || enc()) && resource.data.status == 'pendiente';
    }
  }
}
